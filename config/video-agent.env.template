# ==========================================
# VIDEO AGENT CONFIGURATION
# ==========================================

# Claude API (for script/storyboard generation, color schemes, cinematographic references)
# Required: Get from https://console.anthropic.com
CLAUDE_API_KEY=sk_...
CLAUDE_MODEL=claude-opus

# Image Generation (kie.ai - OpenAI compatible)
# Required: Get from kie.ai dashboard
KIE_API_KEY=c34ecfadf26253dcc8b1764cff0dc65d
KIE_IMAGE_QUALITY=high              # high, normal, or fast
KIE_BATCH_SIZE=5                    # Parallel image requests

# Animation (Kling API)
# Optional: If not set, falls back to Remotion
KLING_API_KEY=sk_...
KLING_API_ENDPOINT=https://api.kling.ai/v1
KLING_ANIMATION_MODEL=kling-v1
KLING_DEFAULT_DURATION=5             # Seconds per clip
KLING_FALLBACK_TO_REMOTION=true     # Use Remotion if Kling fails

# Video Agent Settings
VIDEO_AGENT_ENABLED=true
VIDEO_PROJECT_DIR=./outputs/videos
VIDEO_AUTO_APPROVE_AFTER_MINUTES=0   # 0 = require manual approval
VIDEO_APPROVAL_REQUIRED=false        # Set to false to auto-approve all steps

# ==========================================
# VISUAL ENHANCEMENT FEATURES (NEW)
# ==========================================

# Kling 3.0 Animation (enables motion options feature)
# Get from Kling AI dashboard
KLING_API_KEY=sk_...
KLING_MODEL=kling-v3
KLING_DEFAULT_MOTION_INTENSITY=30    # 0-100

# Frame Continuity (requires FFmpeg installed)
# FFmpeg is auto-detected. Set to 'false' to disable frame continuity.
# Installation: brew install ffmpeg (macOS) or apt-get install ffmpeg (Linux)
FFMPEG_AVAILABLE=true

# Visual Coherence Analysis (no API required, always enabled)
# Validates color consistency, motion flow, and style coherence across scenes
VISUAL_COHERENCE_ENABLED=true

# ==========================================
# ELEVEN LABS AUDIO SYNTHESIS (NEW)
# ==========================================

# Eleven Labs Text-to-Speech for voiceover generation
# Get from https://elevenlabs.io/app/api
ELEVEN_LABS_API_KEY=sk_...          # From https://elevenlabs.io/app/api
ELEVEN_LABS_VOICE_ID=bella          # Voice: bella, josh, samantha, thomas, or custom ID
ELEVEN_LABS_ENABLED=true            # Set to false to disable audio generation

# ==========================================
# API SERVER
# ==========================================

# Port for the HTTP API server (default: 3001)
PORT=3001

# ==========================================
# OUTPUT STORAGE (S3 or Cloudflare R2)
# ==========================================
# If not set, videos are kept locally and callbackUrl receives a file:// path.

# Bucket name (required for S3/R2 upload)
STORAGE_BUCKET=your-videos-bucket

# AWS region (S3 only, default: us-east-1)
STORAGE_REGION=us-east-1

# Custom endpoint — set this for Cloudflare R2:
# STORAGE_ENDPOINT=https://{accountId}.r2.cloudflarestorage.com
STORAGE_ENDPOINT=

# Base URL for public video access (your CDN or bucket public URL)
# Example S3:  https://your-bucket.s3.us-east-1.amazonaws.com
# Example R2:  https://videos.yourdomain.com
STORAGE_PUBLIC_URL=https://videos.yourdomain.com

# S3 / R2 credentials
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# ==========================================
# ADVANCED OPTIONS
# ==========================================

# Remotion API (for video rendering)
# Optional: Only needed for cloud rendering
REMOTION_API_KEY=...

# Logging
DEBUG=false                          # Set to true for verbose logging
