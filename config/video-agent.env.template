# ==========================================
# VIDEO AGENT — SETUP
# ==========================================
#
# 1. Copy this file to .env at the project root:
#       cp config/video-agent.env.template .env
#
# 2. Fill in your KIE_API_KEY (required).
#    Get it at: https://kie.ai → Dashboard → API Keys
#
# 3. Make sure Claude Code CLI is installed and logged in:
#       claude --version   # should print a version number
#       claude login       # if not already authenticated
#    Claude Code replaces the Anthropic API key — no CLAUDE_API_KEY needed.
#
# 4. Optional: add Eleven Labs key for real voiceover.
#    Without it, voiceover is skipped and the video uses silent clips.
#
# ==========================================

# ---- REQUIRED ------------------------------------------------

# kie.ai — image generation (GPT-4o) + animation (Kling 2.6)
# Get from: https://kie.ai → Dashboard → API Keys
KIE_API_KEY=your-kie-api-key-here

# ---- OPTIONAL ------------------------------------------------

# Eleven Labs — voiceover synthesis
# Get from: https://elevenlabs.io/app/api
# ELEVEN_LABS_API_KEY=sk_...
# ELEVEN_LABS_VOICE_ID=bella    # bella | josh | samantha | thomas | custom ID

# ---- VIDEO SETTINGS ------------------------------------------

KIE_IMAGE_QUALITY=high          # high | normal | fast
KIE_BATCH_SIZE=5                # parallel image requests

VIDEO_PROJECT_DIR=./outputs/videos
VIDEO_APPROVAL_REQUIRED=false

# Frame continuity (requires FFmpeg — brew install ffmpeg)
FFMPEG_AVAILABLE=true
VISUAL_COHERENCE_ENABLED=true

# ---- API SERVER (npm run api) --------------------------------

PORT=3001

# ---- STORAGE — S3 or Cloudflare R2 (optional) ---------------
# If not set, the final video stays local.

# STORAGE_BUCKET=your-videos-bucket
# STORAGE_REGION=us-east-1
# STORAGE_PUBLIC_URL=https://videos.yourdomain.com
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# STORAGE_ENDPOINT=https://{accountId}.r2.cloudflarestorage.com  # R2 only
