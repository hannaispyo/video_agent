{
  "name": "video-creator",
  "type": "skill",
  "description": "Fully automatic video creation - generates professional videos end-to-end without interruptions",
  "version": "1.0.0",
  "entry": "agents/video-creator/skill-entry.ts",
  "entryFunction": "videoCreatorSkill",
  "invoke": "/video-creator",
  "parameters": [
    {
      "name": "brief",
      "type": "string",
      "required": true,
      "description": "Video title"
    },
    {
      "name": "audience",
      "type": "string",
      "required": true,
      "description": "Target audience"
    },
    {
      "name": "message",
      "type": "string",
      "required": true,
      "description": "Key message or main point"
    },
    {
      "name": "duration",
      "type": "string",
      "required": false,
      "description": "Video duration in seconds (default: 30)",
      "default": "30"
    },
    {
      "name": "tone",
      "type": "string",
      "required": false,
      "description": "Video tone: energetic, steady, comedic, educational (default: professional)",
      "default": "professional",
      "enum": ["energetic", "steady", "comedic", "educational", "professional"]
    },
    {
      "name": "project",
      "type": "string",
      "required": false,
      "description": "Project name to resume"
    },
    {
      "name": "resume",
      "type": "boolean",
      "required": false,
      "description": "Resume interrupted project (requires --project)",
      "default": false
    },
    {
      "name": "verbose",
      "type": "boolean",
      "required": false,
      "description": "Verbose logging output",
      "default": false
    }
  ],
  "examples": [
    {
      "description": "Create a 30-second productivity video",
      "command": "/video-creator --brief \"3 ADHD Productivity Hacks\" --audience \"ADHD individuals\" --message \"Simple strategies to improve focus\""
    },
    {
      "description": "Create an energetic marketing video",
      "command": "/video-creator --brief \"Authoflow Features\" --audience \"productivity enthusiasts\" --message \"AI-powered ADHD management\" --tone energetic"
    },
    {
      "description": "Resume a project",
      "command": "/video-creator --project my-video --resume"
    }
  ],
  "requirements": {
    "apis": [
      {
        "name": "CLAUDE_API_KEY",
        "service": "Anthropic",
        "required": false,
        "fallback": "Uses template script"
      },
      {
        "name": "KIE_API_KEY",
        "service": "kie.ai",
        "required": false,
        "fallback": "Uses template images"
      },
      {
        "name": "KLING_API_KEY",
        "service": "Kling",
        "required": false,
        "fallback": "Falls back to Remotion"
      }
    ]
  },
  "output": {
    "projectName": "string",
    "outputPath": "string",
    "message": "string",
    "success": "boolean",
    "status": "object"
  }
}
